    "black": "#0B1020",
    "red": "#F87171",
    "green": "#86EFAC",
    "yellow": "#FCD34D",
    "blue": "#4F8CFF",
    "magenta": "#C4B5FD",
    "cyan": "#67E8F9",
    "white": "#E8EEFF",
    "brightBlack": "#64748B",
    "brightRed": "#FCA5A5",
    "brightGreen": "#BBF7D0",
    "brightYellow": "#FDE68A",
    "brightBlue": "#93C5FD",
    "brightMagenta": "#DDD6FE",
    "brightCyan": "#A5F3FC",
    "brightWhite": "#F8FAFC"

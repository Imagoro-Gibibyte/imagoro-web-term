{
  "version": "0.1.0",
  "meta": {
    "note": "Single source of truth for Imagoro Web Term tokens. Derived from the Imagoro UI token set (dark palette + mono font).",
    "sources": [
      "imagoro-ui/design/tokens.json",
      "routing-scouting-app-to-be-named/navigation/frontend/styles.css (:root)",
      "scout_crew/src/scout_crew/gui.py (DARK_QSS)"
    ],
    "copyright": "Apache-2.0, Imagoro contributors"
  },
  "color": {
    "bg": "#0B1020",
    "bg.top": "#111933",
    "surface": "#141C2D",
    "surface.alpha": "rgba(20,28,45,0.82)",
    "overlay": "rgba(14,22,38,0.94)",
    "input": "#020617",
    "tab": "#0F172A",
    "tab.active": "#1E293B",
    "raised": "#1E293B",
